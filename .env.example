# ==========================================
# Clinical Decision Support System (CDSS)
# Environment Configuration
# ==========================================

# 1. Google Gemini API Key (for RAG Analyzer, Fusion, and Adaptive Optimizer)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Groq API Key (for fast Qwen-2.5-72B and DeepSeek-R1 inference)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=

# 3. Serper API Key (Optional: for live Google Scholar & PubMed search)
# Get a free key at: https://serper.dev/
SERPER_API_KEY=

# 4. OpenRouter API Key (Optional fallback)
OPENROUTER_API_KEY=

